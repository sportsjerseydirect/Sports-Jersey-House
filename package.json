{
  "name": "sports-jersey-house",
  "private": true,
  "description": "AI-powered e-commerce platform for Sports Jersey House",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @sjh/database db:generate",
    "db:migrate": "pnpm --filter @sjh/database db:migrate",
    "db:seed": "pnpm --filter @sjh/database db:seed",
    "db:verify": "pnpm --filter @sjh/database db:verify",
    "infra:up": "bash infrastructure/local/up.sh",
    "infra:down": "docker compose -f infrastructure/local/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@next/eslint-plugin-next": "^15.5.2",
    "eslint": "^9.34.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
