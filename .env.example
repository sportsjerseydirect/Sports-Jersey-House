# =============================================================================
# Sports Jersey House — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Application ---
# NODE_ENV is set by Next.js/Node — do not set in .env
# NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Sports Jersey House"

# --- Database (PostgreSQL) ---
# Local Docker Compose default:
DATABASE_URL=postgresql://sjh:sjh@localhost:5432/sports_jersey_house
# Or Supabase pooler URL (Project: Sports Jersey House / vergndtgsrqaqvsjtbds):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Supabase (optional until Auth/client SDK is added) ---
# NEXT_PUBLIC_SUPABASE_URL=https://vergndtgsrqaqvsjtbds.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Redis (cache, sessions, job queues) ---
REDIS_URL=redis://localhost:6379

# --- Search (PostgreSQL full-text search + pgvector) ---
# Search uses DATABASE_URL initially. Add a dedicated search engine later behind
# packages/search without changing application callers.

# --- Object Storage (S3-compatible — product images, assets) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Authentication ---
# Required in production when ADMIN_PASSWORD is set
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Set to require admin login (recommended before any staging/production deploy)
ADMIN_PASSWORD=

# --- AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default model routing (override per agent in config)
AI_DEFAULT_MODEL=
AI_EMBEDDING_MODEL=

# --- Shopify (read-only extraction — NOT connected yet) ---
# Credentials for "Sports Jersey House Extract" app will be provided later.
# Do NOT make Shopify API calls until migration phase is approved.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Email / Notifications (future) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Analytics & Monitoring (future) ---
SENTRY_DSN=
POSTHOG_KEY=

# --- Feature Flags ---
ENABLE_AI_SHOPPING_ASSISTANT=false
ENABLE_SHOPIFY_SYNC=false
# Read-only controlled sample import; not full sync. Never writes to Shopify.
ENABLE_SHOPIFY_SAMPLE_IMPORT=false

# --- Storefront ISR ---
# Max product/collection slugs pre-rendered at build (rest on first request)
STATIC_PRERENDER_LIMIT=200
# Product/collection detail pages use ISR with revalidate=3600 (see route segment config)
